{
  "openapi": "3.0.3",
  "info": {
    "title": "Tinfoil Connection",
    "version": "0.3.0"
  },
  "paths": {
    "/api/connection": {
      "get": {
        "description": "Box-only wizard.ai-connection/1 status, no secret. No provider I/O; cached last successful verification.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        }
      }
    },
    "/api/connect": {
      "post": {
        "description": "Verify enclave and list models before atomically saving key. Requires trusted Origin and X-Wizard-Request: 1. No paid inference.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/test": {
      "post": {
        "description": "Verify stored login and refresh models; empty object. No paid inference.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/disconnect": {
      "post": {
        "description": "Delete stored key and rotate local gateway credential; empty object.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "description": "Box-only local bearer-authenticated connected models.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "description": "Box-only local bearer-authenticated official SDK inference; paid when invoked. Supports buffered SSE. No upstream URL overrides.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "description": "Box-only read-only connection_status MCP.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/admin-key": {
      "post": {
        "description": "Owner page only (trusted Origin + X-Wizard-Request). Save an optional Tinfoil admin key used solely to read billing (usage cost, transactions). Verified against Tinfoil before saving; never returned.",
        "responses": {
          "200": {
            "description": "Sanitized status"
          },
          "400": {
            "description": "Rejected key, nothing saved"
          },
          "403": {
            "description": "Untrusted origin"
          }
        }
      }
    },
    "/api/admin-key/remove": {
      "post": {
        "description": "Delete the saved billing key.",
        "responses": {
          "200": {
            "description": "Sanitized status"
          }
        }
      }
    },
    "/api/private-clients": {
      "post": {
        "description": "Box-only (Agent Service): mint or rotate the relay client token for one private agent. Only its SHA-256 is stored; the token works only on the relay port (8090). Needs the off-by-default 'private-relay' switch; off: 404.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "agent"
                ],
                "additionalProperties": false,
                "properties": {
                  "agent": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{token, relay_url}"
          },
          "400": {
            "description": "Invalid agent id"
          },
          "403": {
            "description": "Forwarded, cross-site or relay-network request"
          },
          "404": {
            "description": "private-relay switch off"
          }
        }
      }
    },
    "/api/private-clients/{agent}": {
      "delete": {
        "description": "Box-only (Agent Service): revoke one private agent's relay token. Idempotent. Off switch: 404.",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "400": {
            "description": "Invalid agent id"
          },
          "404": {
            "description": "private-relay switch off"
          }
        }
      }
    }
  }
}